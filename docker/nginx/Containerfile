ARG NGINX_IMAGE=docker.io/library/nginx:1.30.6-alpine3.24-slim@sha256:dede8895648b461178c3bc604f7eed4423efe5220b2c4d839f5eb3d34ac3f8f7
FROM ${NGINX_IMAGE} AS runtime
RUN apk add --no-cache zlib=1.3.2-r1 curl=8.23.0-r0 \
    && addgroup -g 10001 secpal \
    && adduser -D -u 10001 -G secpal -h /nonexistent -s /sbin/nologin secpal \
    && rm -rf /usr/share/nginx/html /etc/nginx/conf.d
COPY LICENSE /usr/share/licenses/secpal-api/LICENSE
COPY public /app/public
COPY --chown=root:root --chmod=0444 docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --chown=root:root --chmod=0444 docker/nginx/fastcgi.conf /etc/nginx/secpal-fastcgi.conf
COPY --chown=root:root --chmod=0555 docker/nginx/http-live.sh /usr/local/bin/secpal-http-live
RUN find /app -type d -exec chmod 0555 {} + \
    && find /app -type f -exec chmod 0444 {} +
USER secpal
EXPOSE 8080
STOPSIGNAL SIGQUIT
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD /usr/local/bin/secpal-http-live
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
