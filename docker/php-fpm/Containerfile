ARG COMPOSER_IMAGE=docker.io/library/composer:2.10.2@sha256:5946476338742b200bb9ff88f8be56275ddae4b3949c72305cb0dbf10cfcb760
ARG PHP_IMAGE=docker.io/library/php:8.4.27-fpm-alpine3.24@sha256:93aa3f61216b73cc6f878235c9772849449f4efc18dfe3d6678eed645076c00d
FROM ${COMPOSER_IMAGE} AS composer
FROM ${PHP_IMAGE} AS sqlite-build
ARG SOURCE_DATE_EPOCH=0
RUN apk add --no-cache alpine-sdk=1.1-r1 abuild=3.17.0-r0 binutils=2.45.1-r1 \
        gcc=15.2.0-r5 musl-dev=1.2.6-r3 make=4.4.1-r4 readline-dev=8.3.3-r1 \
        tcl=8.6.17-r1 unzip=6.0-r16 openssl=3.5.9-r0
COPY docker/sqlite /build/sqlite
WORKDIR /build/sqlite
RUN ./build.sh

FROM ${PHP_IMAGE} AS extensions
RUN --mount=type=bind,from=sqlite-build,source=/out,target=/tmp/secpal-sqlite,ro \
    apk add --no-cache --no-network --keys-dir=/tmp/secpal-sqlite/keys \
        --repositories-file=/dev/null --repository=/tmp/secpal-sqlite sqlite-libs=3.54.0-r0 \
    && install -D -m 0644 /tmp/secpal-sqlite/provenance.json /usr/share/secpal/sqlite-build.json
COPY docker/python/opentimestamps-requirements.txt /tmp/opentimestamps-requirements.txt
RUN apk add --no-cache --virtual .php-build-deps \
        autoconf=2.73-r0 dpkg-dev=1.23.7-r0 dpkg=1.23.7-r0 file=5.47-r2 \
        g++=15.2.0-r5 gcc=15.2.0-r5 musl-dev=1.2.6-r3 make=4.4.1-r4 pkgconf=2.5.1-r0 re2c=4.5.1-r0 \
        gettext-dev=1.0-r0 icu-dev=78.1-r0 libzip-dev=1.11.4-r2 postgresql18-dev=18.6-r0 \
    && docker-php-ext-install -j2 bcmath gettext intl pcntl pdo_pgsql pgsql zip \
    && apk add --no-cache gettext-libs=1.0-r0 icu-libs=78.1-r0 icu-data-full=78.1-r0 libpq=18.6-r0 libzip=1.11.4-r2 \
        python3=3.14.10-r1 py3-pip=26.1.2-r0 curl=8.23.0-r0 libcurl=8.23.0-r0 brotli-libs=1.2.1-r0 \
    && pip3 install --break-system-packages --no-cache-dir --only-binary=:all: \
        --require-hashes -r /tmp/opentimestamps-requirements.txt \
    && apk del --no-network .php-build-deps \
    && rm -rf /tmp/opentimestamps-requirements.txt /usr/src/php /usr/local/include \
        /usr/local/lib/php/build /usr/local/bin/phpize /usr/local/bin/php-config \
        /usr/local/bin/docker-php-ext-* /usr/local/etc/php-fpm.d/*

FROM extensions AS dependencies
RUN apk add --no-cache unzip=6.0-r16
COPY --from=composer /usr/bin/composer /usr/local/bin/composer
WORKDIR /app
COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/tmp/composer-cache \
    COMPOSER_CACHE_DIR=/tmp/composer-cache composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --no-scripts \
        --prefer-dist
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY lang ./lang
COPY public ./public
COPY resources ./resources
COPY routes ./routes
COPY scripts/ots-stamp-hash.py scripts/ots-upgrade.py scripts/ots-verify.py ./scripts/
COPY storage ./storage
COPY artisan LICENSE THIRD-PARTY-NOTICES.md ./
COPY LICENSES ./LICENSES
COPY docs/ADDRESS_DATA.md ./docs/ADDRESS_DATA.md
RUN rm -f bootstrap/cache/*.php && composer dump-autoload \
        --classmap-authoritative \
        --no-dev \
        --no-interaction \
        --no-scripts \
    && php artisan package:discover --ansi
FROM extensions AS runtime

ARG APP_UID=10001
ARG APP_GID=10001

ENV APP_ENV=production \
    APP_NAME=Laravel \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data

WORKDIR /app

# The extension installer removes build dependencies; native smoke rejects retained headers.
RUN addgroup -g "${APP_GID}" secpal \
    && adduser -D -u "${APP_UID}" -G secpal -h /home/secpal -s /sbin/nologin secpal \
    && install -d -m 0750 -o secpal -g secpal /config/psysh /data /run/secpal-fpm

COPY --from=dependencies --chown=root:root /app /app
COPY --chown=root:root --chmod=0644 docker/php-fpm/pool.conf /usr/local/etc/php-fpm.d/api.conf
COPY --chown=root:root --chmod=0644 docker/php/conf.d/production.ini /usr/local/etc/php/conf.d/zz-secpal-production.ini

RUN cp "${PHP_INI_DIR}/php.ini-production" "${PHP_INI_DIR}/php.ini" \
    && chmod 0644 /usr/local/etc/php-fpm.d/api.conf \
    && chmod 0644 "${PHP_INI_DIR}/conf.d/zz-secpal-production.ini" \
    && find /app -xdev -type d -exec chmod 0755 {} + \
    && find /app -xdev -type f -exec chmod 0644 {} + \
    && install -d -m 0750 -o secpal -g secpal \
        storage/app/private \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R secpal:secpal storage bootstrap/cache \
    && find storage bootstrap/cache -type d -exec chmod 0750 {} + \
    && find storage bootstrap/cache -type f -exec chmod 0640 {} +

USER secpal

COPY --chown=root:root --chmod=0444 docker/healthchecks/fpm-live.php /usr/local/bin/secpal-fpm-live.php

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["php", "/usr/local/bin/secpal-fpm-live.php"]
STOPSIGNAL SIGQUIT
CMD ["php-fpm", "--nodaemonize"]
