APP_NAME=SecPal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.secpal.dev
# Public mobile bootstrap (`GET /v1/bootstrap`) derives `api_base_url` from APP_URL.
# Set the required minimum app version/build before enabling it on a customer-hosted deployment.
# BOOTSTRAP_PUBLIC_ENABLED=true
# BOOTSTRAP_INSTANCE_DISPLAY_NAME=SecPal Demo
# BOOTSTRAP_MINIMUM_SUPPORTED_APP_VERSION=1.4.0
# BOOTSTRAP_MINIMUM_SUPPORTED_APP_BUILD=10400
# BOOTSTRAP_API_RELEASE_VERSION=api-2026-07-03
# BOOTSTRAP_API_RELEASE_SOURCE_URL=https://github.com/SecPal/api/releases/download/api-2026-07-03/source.tar.gz
# BOOTSTRAP_PASSWORD_LOGIN_ENABLED=true
# BOOTSTRAP_PASSKEY_LOGIN_ENABLED=true
# BOOTSTRAP_MANAGED_ANDROID_ENROLLMENT_ENABLED=false
# BOOTSTRAP_RETRYABLE=true
# BOOTSTRAP_RETRY_AFTER_SECONDS=60
# Customer-owned Android push delivery stays backend-only; never expose these through GET /v1/bootstrap.
# ANDROID_PUSH_FCM_PROJECT_ID=customer-owned-push
# ANDROID_PUSH_FCM_CLIENT_EMAIL=firebase-adminsdk-abc123@customer-owned-push.iam.gserviceaccount.com
# ANDROID_PUSH_FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ANDROID_PUSH_FCM_TOKEN_URI=https://oauth2.googleapis.com/token
# ANDROID_PUSH_FCM_API_BASE_URL=https://fcm.googleapis.com
# ANDROID_PUSH_FCM_CONNECT_TIMEOUT=5
# ANDROID_PUSH_FCM_TIMEOUT=10
# Customer-owned browser Web Push uses the public bootstrap VAPID key plus backend-only delivery secrets.
# BOOTSTRAP_WEB_PUSH_ENABLED=true
# BOOTSTRAP_WEB_PUSH_METADATA_REVISION=5
# BOOTSTRAP_WEB_PUSH_PUBLIC_VAPID_KEY=BE9tfo-aCxwtPk9QYXKDlAUGBwgJCgsMDQ4PEBESExQVobLD1OX2BxgpMEFSY3SFlgcYKTBLXG1-j5ABAgMEBQY
# WEB_PUSH_VAPID_SUBJECT=mailto:notifications@secpal.dev
# WEB_PUSH_VAPID_PRIVATE_KEY=REPLACE_WITH_BASE64URL_VAPID_PRIVATE_KEY
# WEB_PUSH_DELIVERY_TTL=300
# WEB_PUSH_DELIVERY_URGENCY=normal
# WEB_PUSH_DELIVERY_CONNECT_TIMEOUT=5
# WEB_PUSH_DELIVERY_TIMEOUT=20
FRONTEND_URL=https://app.secpal.dev
# Optional override for native Android passkey origin validation when a
# non-canonical signing key is used outside the official SecPal release path.
# ANDROID_SIGNING_CERTIFICATE_SHA256_FINGERPRINT=C3:E9:FD:07:69:F3:34:9B:B0:B0:56:BA:E6:69:47:23:40:E1:CB:28:66:26:DE:30:C9:C9:FA:F9:5F:1E:47:B5

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=secpal
DB_USERNAME=secpal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.secpal.dev
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sanctum SPA Configuration
# Development: app.secpal.dev
SANCTUM_STATEFUL_DOMAINS=app.secpal.dev
SANCTUM_TOKEN_EXPIRY_MINUTES=1440
SANCTUM_TOKEN_PREFIX=sec_

# CORS Configuration for SPA
# Allow credentials (cookies) from the frontend origins
# Development: https://app.secpal.dev
CORS_ALLOWED_ORIGINS=https://app.secpal.dev
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-XSRF-TOKEN
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=86400

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Bitcoin header verification requires at least two distinct API base URLs.
OTS_BITCOIN_HEADER_API_BASES=https://blockstream.info/api,https://mempool.space/api

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@secpal.dev"
MAIL_FROM_NAME="${APP_NAME}"

# HR Email (for onboarding alerts and notifications)
MAIL_HR_EMAIL="hr@secpal.dev"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Encryption Keys
KEK_PATH=/home/appuser/.secrets/kek
KEY_CACHE_TTL=5
KEY_ROTATION_BATCH_SIZE=100
KEY_ROTATION_CHECKPOINT=500

# Polyglot / gettext
# The API uses repo-native PO/Gettext catalogs via Polyglot.
# Keep the UI blocked in production; use POedit or direct file edits for translations.
POLYGLOT_GETTEXT=true

# German street autocomplete (OpenPLZ API Data — ODbL). CSV is not shipped in the repo.
ADDRESS_DATA_SOURCE_URL=https://github.com/openpotato/openplzapi.data/raw/refs/heads/main/src/de/osm/streets.updated.csv
ADDRESS_DATA_UPDATE_FREQUENCY=weekly
# Default on: composer "setup" imports German street data after migrate when none exists (needs network). Set false for offline/CI.
ADDRESS_DATA_IMPORT_ON_SETUP=true
# Optional local CSV for setup seeding/imports, useful for offline development images.
# ADDRESS_DATA_SETUP_SOURCE_PATH=/absolute/path/to/streets.updated.csv
