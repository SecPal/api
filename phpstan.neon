includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    treatPhpDocTypesAsCertain: false
    paths:
        - app
        - config
        - database
        - routes

    # PHPStan performance configuration
    tmpDir: build/phpstan
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 300.0

    # Note: Memory limit is configured in scripts/preflight.sh (512M)
    # to prevent crashes during analysis of large codebases (51+ files).
    # PHPStan is invoked with: php -d memory_limit=512M ./vendor/bin/phpstan

    # Ignore errors in generated files
    excludePaths:
        - bootstrap/cache/*
        - storage/*
        - vendor/*
        - tests/* # Pest dynamic properties cause false positives

    # Laravel specific
    noUnnecessaryCollectionCall: true
    noUnnecessaryCollectionCallOnly: []
    noUnnecessaryCollectionCallExcept: []

    # Ignore errors in vendor migrations (spatie/laravel-permission)
    ignoreErrors:
        -
            message: '#Cannot access offset .* on mixed#'
            path: database/migrations/*_create_permission_tables.php
        -
            message: '#Parameter .* expects .*, mixed given#'
            path: database/migrations/*_create_permission_tables.php

        # Laravel Eloquent BelongsTo covariance limitation - known PHPStan issue with template types
        -
            message: '#Method App\\Models\\Person::tenantKey\(\) should return .* but returns .*#'
            path: app/Models/Person.php

        # Laravel JsonResource magic property access - false positives
        # JsonResource proxies property access to $this->resource, but PHPStan sees undefined properties
        -
            message: '#Access to an undefined property App\\Http\\Resources\\ActivityResource::\$.*#'
            path: app/Http/Resources/ActivityResource.php
        -
            message: '#Call to an undefined method App\\Http\\Resources\\ActivityResource::.*#'
            path: app/Http/Resources/ActivityResource.php
        -
            message: '#Cannot call method .* on mixed#'
            path: app/Http/Resources/ActivityResource.php
        -
            message: '#Cannot access property .* on mixed#'
            path: app/Http/Resources/ActivityResource.php
        -
            message: '#Parameter .* expects .*, mixed given#'
            path: app/Http/Resources/ActivityResource.php
        -
            message: '#PHPDoc tag @extends contains generic type .* but class .* is not generic#'
            path: app/Http/Resources/ActivityResource.php

        # Query builder type inference limitation in nested closures
        -
            message: '#Variable \$rankQueryBuilder in PHPDoc tag @var does not match any variable in the foreach loop#'
            path: app/Http/Controllers/Api/V1/ActivityLogController.php
        -
            message: '#Cannot call method orWhere\(\) on mixed#'
            path: app/Http/Controllers/Api/V1/ActivityLogController.php
        -
            message: '#Method App\\Models\\RoleAssignmentLog::(user|role|assignedBy)\(\) should return .* but returns .*#'
            path: app/Models/RoleAssignmentLog.php

        # Laravel validation closure $fail callback - known PHPStan limitation
