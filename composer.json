{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "laravel/laravel",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.4",
    "codewiser/polyglot": "^2.1",
    "laragear/two-factor": "^4.0",
    "laravel/framework": "^13.23",
    "laravel/sanctum": "^4.3",
    "laravel/tinker": "^3.0",
    "minishlink/web-push": "^11.0",
    "opis/json-schema": "^2.4",
    "spatie/laravel-activitylog": "^5.1",
    "spatie/laravel-permission": "^8.3",
    "web-auth/webauthn-lib": "^5.3"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.7",
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.11",
    "laravel/boost": "^2.7.0",
    "laravel/pail": "^1.2.7",
    "laravel/pint": "^1.30",
    "laravel/sail": "^1.67",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "pestphp/pest": "^4.7",
    "pestphp/pest-plugin-laravel": "^4.1",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "@php artisan addresses:import --if-empty --setup-only --no-interaction"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php scripts/dev.php"
    ],
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan config:clear --ansi",
      "@php artisan test --parallel --exclude-group=serial",
      "@php artisan test --group=serial"
    ],
    "test:container-policy": [
      "pest --no-coverage tests/Policy/ContainerImageDefinitionTest.php tests/Policy/ContainerPublishingWorkflowTest.php"
    ],
    "analyse": "@php -d memory_limit=512M ./vendor/bin/phpstan analyse",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
