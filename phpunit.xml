<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="APP_URL" value="https://api.secpal.dev" force="true"/>
        <env name="FRONTEND_URL" value="https://app.secpal.dev" force="true"/>
        <env name="CORS_ALLOWED_ORIGINS" value="https://app.secpal.dev" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="testing" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="ADDRESS_DATA_IMPORT_ON_SETUP" value="false" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="app.secpal.dev" force="true"/>
        <!-- database driver is required so Sanctum stateful SPA flows can persist sessions between test requests -->
        <env name="SESSION_DRIVER" value="database" force="true"/>
        <!-- null disables the Domain= cookie attribute; empty string would produce an invalid Domain= header -->
        <env name="SESSION_DOMAIN" value="null" force="true"/>
        <env name="SESSION_SECURE_COOKIE" value="false" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
